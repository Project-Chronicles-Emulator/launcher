+namespace chronicles::launcher {
+void start_in_process_zone_unlock();
+}
+
+// Steamworks v161 imports this initialization entry point from steam_api64.dll.
+STEAMAPI_API int S_CALLTYPE SteamInternal_SteamAPI_Init(const char *version, void *error)
+{
+    (void)version;
+    (void)error;
+    chronicles::launcher::start_in_process_zone_unlock();
+    return SteamAPI_Init() ? 0 : 1;
+}
+
+// The authoritative game server is hosted separately from this local API shim.
+STEAMAPI_API steam_bool S_CALLTYPE SteamInternal_GameServer_Init_V2(
+    uint32 ip, uint16 game_port, uint16 query_port, int server_mode,
+    const char *game_version, const char *interface_version, void *error)
+{
+    (void)ip;
+    (void)game_port;
+    (void)query_port;
+    (void)server_mode;
+    (void)game_version;
+    (void)interface_version;
+    (void)error;
+    return false;
+}
